extends = Mcsr132
*.satellite[*].net.routing.service = "TS"


[Config Mcsr132HR]
displayName = "기본 통신 · MCSR-HR"
additional = true
description = "MCSR routing, high-reliability (HR) service: jitter < 15 ms, then largest available buffer"
extends = Mcsr132
*.satellite[*].net.routing.service = "HR"


[Config Mcsr132Pair]
displayName = "단일 구간 통신 · MCSR"
additional = true
description = "MCSR: single downlink flow Goldstone (DSN) -> Flight ICN-LAX for easy visual tracking"
extends = Mcsr132
*.station[0].traffic.dstStation = 11
*.station[0].traffic.sendInterval = 1s
*.station[1..8].traffic.enabled = false

# ---------------- ISL failure experiments (resilience, MCSR Sec. V) ----------------
# IslFailureInjector (src/Global/Topology_Control) cuts ISLs and brings them back; routing modules are
# told immediately. "route@T+D" cuts the middle ISL of the route the routing module reported last, so the
# failure hits the path in use whichever algorithm chose it (same failures for Dijkstra and MCSR).
# The injector draws from its own random-number stream, so random failures are identical in all configs.

[Config IslFailures]
abstract = true
num-rngs = 2
seed-1-mt = 4242
*.islFailures.rng-0 = 1
*.islFailures.logFile = "results/failures-${configname}-${runnumber}.csv"


[Config Mcsr132PairFail]
displayName = "반복 링크 장애 · MCSR"
additional = true
description = "MCSR, 1 flow (50 pkt/s) Goldstone -> Flight ICN-LAX; the path in use is cut at 60/120/180 s for 30 s"
extends = Mcsr132Pair, IslFailures
sim-time-limit = 300s
*.station[0].traffic.sendInterval = 20ms        # many packets in flight so the cut hits packets on the path
*.islFailures.schedule = "route@60+30 route@120+30 route@180+30"


[Config Dijkstra132PairFail]
displayName = "반복 링크 장애"
description = "Dijkstra baseline for Mcsr132PairFail: identical traffic and failures"
extends = Dijkstra132Pair, IslFailures
sim-time-limit = 300s
*.station[0].traffic.sendInterval = 20ms
*.islFailures.schedule = "route@60+30 route@120+30 route@180+30"


[Config Mcsr132RandomFail]
displayName = "무작위 링크 장애 · MCSR"
additional = true
description = "MCSR, default downlink traffic, 20 random ISL failures of 30 s between 30 and 570 s"
extends = Mcsr132, IslFailures
*.islFailures.randomFailures = 20
*.islFailures.randomStart = 30s
*.islFailures.randomEnd = 570s
*.islFailures.randomDuration = 30s


[Config Dijkstra132RandomFail]
displayName = "무작위 링크 장애"
description = "Dijkstra baseline for Mcsr132RandomFail: identical traffic and failures"
extends = Dijkstra132, IslFailures
*.islFailures.randomFailures = 20
*.islFailures.randomStart = 30s
*.islFailures.randomEnd = 570s
*.islFailures.randomDuration = 30s


[Config PaperS1]
displayName = "대규모 단일 구간"
description = "Paper environment: Starlink S1 + 100 city GS, CBR Rio de Janeiro (station[18]) -> Sankt Peterburg (station[73]); Dijkstra routing"
extends = BlindKineis, UHF, ServiceEveryMinute
sim-time-limit = 200s
**.numTerminals = 0
include stations/WorldCities100.ini
*.numSatellites = 1584
*.**.planeCount = 72
*.**.interPlaneSpacing = 1                         # phase factor f = 1
*.constellationCreator.altitude = 550
*.constellationCreator.inclination = 53
*.topologyControl.minimumElevation = 25.0
*.station[*].**.minimumElevation = 25.0
*.topologyControl.islDatarate = 1000000000         # ISL 1 Gbit/s
*.topologyControl.groundlinkDatarate = 100000000   # GSL 100 Mbit/s
*.satellite[*].net.packetHandler.queueCapacity = 500   # buffer queue length B
# NOTE: OMNeT++ uses the FIRST matching ini line, so the specific station[18] line must come before the wildcard
*.station[18].traffic.enabled = true
*.station[*].traffic.enabled = false
*.station[*].traffic.packetSize = 1380B
*.station[18].traffic.dstType = "station"
*.station[18].traffic.dstStation = 73
*.station[18].traffic.startTime = 1s
*.station[18].traffic.sendInterval = 1380*8/(${rateMbps=10,20,30,40,50}*1e6)*1s   # CBR of rateMbps Mbit/s
*.mapDataSource.routeLogFile = "results/routes-${configname}-${rateMbps}.csv"
*.mapDataSource.failureRouteSrc = 18                # "route@T" cuts follow the measured flow only (matters with background load)
*.mapDataSource.failureRouteDst = 73
*.station[73].traffic.flowSrc = 18                  # QoS/gap statistics of the measured flow only (background flows excluded)
*.mapDataSource.graphLogFile = ""


[Config PaperS1Load]
displayName = "대규모 부하"
description = "Paper environment, background load: the 20 largest cities send CBR to random cities (all rates 10..50 Mbit/s)"
extends = PaperS1
*.station[0..19].traffic.enabled = true
*.station[0..19].traffic.dstType = "station"
*.station[0..19].traffic.dstStation = -1
*.station[0..19].traffic.startTime = uniform(1s, 3s)
*.station[0..19].traffic.sendInterval = 1380*8/(${rateMbps}*1e6)*1s


[Config PaperS1Mcsr]
displayName = "대규모 단일 구간 · MCSR-LS"
additional = true
description = "Paper environment, MCSR-LS (latency-sensitive)"
extends = PaperS1
*.satellite[*].net.routingType = "Sat_Net_McsrRouting"
*.satellite[*].net.routing.service = "LS"
*.satellite[*].net.routing.labelCap = 32
*.satellite[*].net.routing.jitterSource = "arrival"
*.satellite[*].net.routing.snapshotOnDelayUpdate = false   # do not rebuild the 1584-satellite snapshot at every 1 s delay update
*.satellite[*].net.routing.refreshInterval = 5s    # A and J follow the traffic every 5 s (lower = more accurate, much slower)


[Config PaperS1McsrTS]
displayName = "대규모 단일 구간 · MCSR-TS"
additional = true
description = "Paper environment, MCSR-TS (throughput-sensitive)"
extends = PaperS1Mcsr
*.satellite[*].net.routing.service = "TS"


[Config PaperS1McsrHR]
displayName = "대규모 단일 구간 · MCSR-HR"
additional = true
description = "Paper environment, MCSR-HR (high-reliability: jitter < 15 ms, then largest buffer)"
extends = PaperS1Mcsr
*.satellite[*].net.routing.service = "HR"


[Config PaperS1Dijkstra]
displayName = "대규모 단일 구간 · Dijkstra"
additional = true
description = "Paper environment, delay-shortest-path baseline (SPF)"
extends = PaperS1
*.satellite[*].net.routing.metric = "delay"


[Config PaperS1McsrFail]
displayName = "대규모 무작위 링크 장애 · MCSR"
additional = true
description = "Paper environment, MCSR-LS with 20 random ISL failures of 30 s (resilient rerouting)"
extends = PaperS1Mcsr, IslFailures
*.islFailures.randomFailures = 20
*.islFailures.randomStart = 20s
*.islFailures.randomEnd = 170s
*.islFailures.randomDuration = 30s


[Config PaperS1DijkstraFail]
displayName = "대규모 무작위 링크 장애 · Dijkstra"
additional = true
description = "Paper environment, SPF baseline with the same random ISL failures"
extends = PaperS1Dijkstra, IslFailures
*.islFailures.randomFailures = 20
*.islFailures.randomStart = 20s
*.islFailures.randomEnd = 170s
*.islFailures.randomDuration = 30s

# Targeted cuts: the middle ISL of the path currently used by the Rio -> Sankt Peterburg flow is cut for 30 s (x3).
# The random configs above rarely hit a single path out of ~3000 ISLs; these always do.

[Config PaperS1McsrCut]
displayName = "대규모 반복 링크 장애 · MCSR"
additional = true
description = "Paper environment, MCSR-LS: the ISL in the middle of the path in use is cut at 60/110/160 s for 30 s"
extends = PaperS1Mcsr, IslFailures
*.islFailures.schedule = "route@60+30 route@110+30 route@160+30"


[Config PaperS1DijkstraCut]
displayName = "대규모 반복 링크 장애 · Dijkstra"
additional = true
description = "Paper environment, SPF baseline with the same targeted cuts"
extends = PaperS1Dijkstra, IslFailures
*.islFailures.schedule = "route@60+30 route@110+30 route@160+30"

# ---- regional congestion, environment mode (NOT part of the MCSR paper; mark the results accordingly) ----
# CongestionInjector: a region is declared congested once (rho, start, duration), no packets are sent. Every ISL with an
# endpoint inside gets capacity C*(1-rho) and an M/M/1 queueing delay; MCSR sees A' = min(A, 1-rho) and the queue jitter.
# Geographic zones follow the geography (the loaded satellites change while the constellation moves). Dijkstra sees
# the extra delay only with congestionAware=true. Zone syntax: see CongestionInjector.ned.

[Config Congestion]
abstract = true
*.congestionInjector.logFile = "results/congestion-${configname}-${runnumber}.csv"

# Zone centred on the middle of the Rio -> Sankt Peterburg great circle (22N 19W), radius 1500 km, rho 0.9 from 60 s to 160 s.
# At 1 Gbit/s the M/M/1 queueing delay is only microseconds, so the zone also carries a 10 ms penalty delay per loaded hop
# (the "/10"); without it the congestion would barely change the path choice of an SPF that knows the delay.

[Config PaperS1McsrCongestion]
displayName = "대규모 혼잡 · MCSR"
additional = true
description = "Paper environment, MCSR-LS, congested region on the path (rho 0.9, 60..160 s) - environment mode, not in the paper"
extends = PaperS1Mcsr, Congestion
*.congestionInjector.zones = "circle(22,-19,1500)=0.9/10@60+100"


[Config PaperS1DijkstraCongestion]
displayName = "대규모 혼잡 · Dijkstra"
additional = true
description = "Paper environment, SPF baseline, same congested region; SPF does not know about the queueing delay"
extends = PaperS1Dijkstra, Congestion
*.congestionInjector.zones = "circle(22,-19,1500)=0.9/10@60+100"


[Config PaperS1DijkstraCongestionAware]
displayName = "대규모 혼잡 · 지연 반영"
additional = true
description = "Paper environment, SPF baseline whose link cost includes the injected queueing delay"
extends = PaperS1DijkstraCongestion
*.satellite[*].net.routing.congestionAware = true

# ---- failure-knowledge model (T08 detection + T16 recovery decomposition) ----
# failureKnowledge="propagate": a cut ISL is physically down at once, but a satellite learns of it only after
#   detection (slsInterval * slsMissCount = 600 ms, temporary assumption) + flooding (floodHopDelay per hop, assumption).
#   Dijkstra: global flooding + spfDelay;  MCSR: only satellites within failureScopeHops (SRD-like scope) + repairDelay,
#   the rest is repaired locally on the way.  Until a satellite knows, it routes into the dead link and the packet is lost.

[Config FailureKnowledge]
abstract = true
*.topologyControl.failureKnowledge = "propagate"
# slsInterval (200ms), slsMissCount (3) and floodHopDelay (2ms) keep their NED defaults so they can be swept from the
# command line, e.g.  "--*.topologyControl.floodHopDelay=50ms"  (a value written here would win over the command line)
*.station[*].traffic.gapThreshold = 100ms
*.station[*].traffic.gapLogFile = "results/gaps-${configname}-${runnumber}.csv"


[Config PaperS1McsrCutFlood]
displayName = "대규모 장애·복구 · MCSR"
additional = true
description = "Paper environment, MCSR-LS, targeted cuts with detection + scoped flooding + local repair"
extends = PaperS1McsrCut, FailureKnowledge
*.satellite[*].net.routing.failureScopeHops = 6
*.satellite[*].net.routing.repairDelay = 5ms


[Config PaperS1DijkstraCutFlood]
displayName = "대규모 장애·복구"
*.satellite[*].net.routing.algorithm = "dijkstra-delay"
*.satellite[*].net.routingType = "Sat_Net_DijkstraRouting"
*.satellite[*].net.routing.metric = "delay"
description = "Paper environment, SPF baseline, same cuts with detection + global flooding + SPF delay"
extends = PaperS1DijkstraCut, FailureKnowledge
*.satellite[*].net.routing.spfDelay = 50ms


[Config PaperS1McsrCutFloodRes]
displayName = "대규모 장애·복구 · 예비 경로"
additional = true
description = "Paper environment, MCSR-LS with reserved dominant paths: on a lost link/exit switch to a stored path (suffix from the noticing satellite), recompute only if none is usable"
extends = PaperS1McsrCutFlood
*.satellite[*].net.routing.reservedPaths = true
*.satellite[*].net.routing.reserveDelay = 1ms

# ---- background load (A/J differ between paths, so dominant path sets are larger than one path) ----
# Kept light on purpose: MCSR with 19 background flows ran ~100x slower than real time. 4 background sources and one cut
# in 100 s are enough to see whether stored dominant paths are used.
# LoadBackground must be listed FIRST in "extends": the first matching ini line wins, and PaperS1 switches all stations off.
# station[18] (the measured flow towards station[73]) is not among the background sources; none of them sends to 73.

[Config LoadBackground]
abstract = true
sim-time-limit = 100s
*.islFailures.schedule = "route@60+30"
# Fixed destinations: a random destination per packet makes every packet a new (satellite, destination) planning problem
# (73k plan computations in the access phase vs 325 without background flows) and the run ~15x slower than Dijkstra.
*.station[0..3].traffic.enabled = true
*.station[0..3].traffic.dstType = "station"
*.station[0].traffic.dstStation = 7
*.station[1].traffic.dstStation = 2
*.station[2].traffic.dstStation = 11
*.station[3].traffic.dstStation = 4
*.station[0..3].traffic.startTime = uniform(1s, 3s)
*.station[0..3].traffic.sendInterval = 1380*8/(${rateMbps}*1e6)*1s


[Config PaperS1DijkstraCutFloodLoad]
displayName = "대규모 장애·복구 · 배경 부하 · Dijkstra"
additional = true
extends = LoadBackground, PaperS1DijkstraCutFlood


[Config PaperS1McsrCutFloodLoad]
displayName = "대규모 장애·복구 · 배경 부하 · MCSR"
additional = true
extends = LoadBackground, PaperS1McsrCutFlood


[Config PaperS1McsrCutFloodResLoad]
displayName = "대규모 장애·복구 · 예비 경로·배경 부하"
additional = true
extends = LoadBackground, PaperS1McsrCutFloodRes

# ---- DS / CSIB over simulated control packets ----

[Config PaperS1McsrCsib]
displayName = "대규모 DS·CSIB"
additional = true
description = "Paper environment, MCSR-LS with packet-based DS/CSIB (180 s period, voting enabled)"
extends = PaperS1Mcsr
*.native.controlMode = "packet"
*.satellite[*].net.routing.csibEnabled = true
*.satellite[*].net.routing.csibPeriod = 180s
*.satellite[*].net.routing.csibVote = true


