*.station[2].traffic.dstStation = 12
*.station[2].traffic.dstType = "mobile"
*.station[3].traffic.dstStation = 12
*.station[3].traffic.dstType = "mobile"
*.station[4].traffic.dstStation = 12
*.station[4].traffic.dstType = "mobile"
*.station[5].traffic.dstStation = 12
