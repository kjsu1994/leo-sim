*.station[8].traffic.sendInterval = 0.001
*.congestion.scenarioFile = "scenarios/default-scenario-00455a29dd14.json"
description = "MCSR routing, latency-sensitive (LS) service; same downlink traffic as Dijkstra132"
extends = Dijkstra132
